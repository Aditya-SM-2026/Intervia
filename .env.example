# Copy to .env (gitignored). The web app and the agent worker (agent/) both
# read this file, so every value is set once.

# LiveKit: carries the candidate's audio/video and the interviewer's voice.
# Local development: `docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp
#   livekit/livekit-server --dev --bind 0.0.0.0 --node-ip 127.0.0.1`
# then use ws://127.0.0.1:7880 with devkey / secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini: the live interviewer voice, plan generation and scorecards.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Charon
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# Silence (ms) after which the candidate's turn is considered finished.
# GEMINI_TURN_SILENCE_MS=500
# Reasoning tokens before the interviewer speaks. 0 = fastest replies; "default" lets the model decide.
# GEMINI_THINKING_BUDGET=0
# Cost controls for the live voice model. Built, not yet proven in a live
# interview, so off by default. Gemini Live bills everything it remembers again
# on each reply; these keep what it remembers small.
# INTERVIA_TOPIC_RESET=1
# GEMINI_CONTEXT_TRIGGER_TOKENS=9000
# GEMINI_CONTEXT_TARGET_TOKENS=5000
# Languages the candidate's captions are pinned to (comma-separated).
# GEMINI_TRANSCRIPTION_LANGUAGES=en-US

# Shared secret between the web app and the agent worker (any long random string).
AGENT_API_SECRET=
# Where the agent worker reaches the web app.
INTERVIA_WEB_URL=http://localhost:3000

# Recruiter sign-in for /recruiter and /dashboard. In production, access is
# refused until a password is set. SESSION_SECRET signs the session cookie.
RECRUITER_PASSWORD=
SESSION_SECRET=
# Login ID shown on the admin sign-in form (default: admin). A name, not a
# secret — the password is the credential.
ADMIN_USERNAME=

# Postgres (Cloud SQL in production). Without it, data is kept in memory and
# lost when the web app restarts.
# DATABASE_URL=

# Recording to Google Cloud Storage (audio + video, via LiveKit Egress).
# Needs LiveKit Cloud or a self-hosted egress service; skipped when unset.
# RECORDING_GCS_BUCKET=
# RECORDING_GCS_CREDENTIALS_JSON=

# Overall score weights, in percent: answer quality, resume match, own answers,
# on-camera behaviour. A factor without a score is left out and the rest carry it.
# SCORE_WEIGHTS=45,20,20,15
# Model used to analyse the candidate recording (defaults to GEMINI_TEXT_MODEL).
# VIDEO_ANALYSIS_MODEL=
# Where the on-camera analysis runs: "inline" (default, in the web process) or
# "worker" (a separate Cloud Run service, so a long recording never holds a
# page request open). See worker/ and cloudbuild-worker.yaml.
# VIDEO_ANALYSIS_MODE=inline
# Worker service, e.g. https://intervia-video-worker-xxxx.run.app
# VIDEO_WORKER_URL=
# Shared secret between the web app and the worker, in both directions.
# INTERNAL_SECRET=
# Cloud Tasks queue that delivers jobs to the worker (unset: call it directly).
# TASKS_PROJECT=siva-nikhil
# TASKS_LOCATION=asia-south1
# TASKS_QUEUE=intervia-video-analysis
# Service account Cloud Tasks uses to call the worker.
# TASKS_INVOKER_SA=tasks-invoker@siva-nikhil.iam.gserviceaccount.com
# Reading recordings from Cloud Storage outside Google Cloud needs a token,
# for example from `gcloud auth print-access-token`.
# GCS_ACCESS_TOKEN=

# Fallback text LLM when no Gemini key is set (plan generation and scoring only).
# OMINIBOT_API_KEY=
# OMINIBOT_API_BASE_URL=https://api.ominibot.com/v1
# OMINIBOT_MODEL=ominibot

# --- Analysis provider ---------------------------------------------------
# Plans, scorecards and video analysis use Ominibot when its key is set, with
# Gemini as the fallback. ANALYSIS_PROVIDER=gemini reverses the order.
# OMINIBOT_API_KEY=omk_...
# ANALYSIS_PROVIDER=ominibot

# --- Recording -----------------------------------------------------------
# Candidate recordings uploaded by the browser are kept here (default
# .data/recordings). FFMPEG_PATH overrides the bundled ffmpeg.

# --- Candidate resume uploads (Task 5) -------------------------------------
# Uploaded files are stored under this directory, one folder per interview.
# UPLOADS_DIR=
# RECORDINGS_DIR=
# FFMPEG_PATH=
# When set, each finished recording is also uploaded to this GCS bucket, so
# playback works from any deployment and survives container restarts.
# The bucket path is logged as a recording_uploaded event per interview.
# RECORDINGS_GCS_BUCKET=

# --- Voice mode ----------------------------------------------------------
# "Lower cost" interviews renew the voice session at this age, in seconds.
# INTERVIA_ROLLING_SECONDS=90

# --- Email (Task 3: invitation emails) -------------------------------------
# Any SMTP provider works (Gmail with an app password, Mailtrap for testing).
# Email sending stays off until all three of SMTP_HOST, SMTP_USER and
# SMTP_PASSWORD are set; interviews are created regardless of email failures.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address shown on invitation emails.
EMAIL_FROM="Intervia Interviews <interviews@intervia.ai>"
# Timezone used to render the interview time inside emails.
# Public origin used in reminder-email links (no request context there).
# Set this to the deployed URL, e.g. https://intervia-xyz-uc.a.run.app
INTERVIA_PUBLIC_ORIGIN=
EMAIL_TIMEZONE=Asia/Kolkata
