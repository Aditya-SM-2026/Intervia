# Ominibot LLM service (server-only, never exposed to the browser).
# Paste your API key here — it is read from .env, which is gitignored.
OMINIBOT_API_KEY=
OMINIBOT_API_BASE_URL=https://api.ominibot.com/v1
OMINIBOT_MODEL=ominibot
# Set to "mock" to force the mock LLM provider in local development.
OMINIBOT_PROVIDER=

# LiveKit (server-only keys; the client receives the URL and a short-lived
# token from the backend — never from these variables).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live voice (optional; the default "agent" pipeline needs none of these)
GEMINI_API_KEY=
# GEMINI_BACKEND=studio
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
NEXT_PUBLIC_VOICE_PROVIDER=agent

# Cascade voice (agent worker + Cloud TTS; requires cloudtts.user role on the runtime identity)
# AGENT_TTS_PROVIDER=cloud
# CLOUD_TTS_VOICE=en-US-Chirp3-HD-Charon

# LiveKit room name prefix. Set a different value (e.g. dev-) locally to keep
# local test rooms away from a deployed agent watching the same LiveKit project.
# MEETINGBOT_ROOM_PREFIX=interview-
